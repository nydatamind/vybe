<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg_glass"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Album Art with Rounded Frame -->
    <FrameLayout
        android:id="@+id/widget_art_container"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/widget_art_bg"
        android:padding="2dp">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/app_logo" />
    </FrameLayout>

    <!-- Track & Artist Information -->
    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● VYBE STUDIO"
            android:textColor="#00FF88"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_track_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="VYBE Music"
            android:textColor="#FFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ready to play"
            android:textColor="#C5C2DA"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Controls Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Previous Button -->
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_btn_control_bg"
            android:contentDescription="Previous Track"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_skip_previous" />

        <!-- Play / Pause Circular Glowing Button -->
        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_btn_play_bg"
            android:contentDescription="Play or Pause"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />

        <!-- Next Button -->
        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_btn_control_bg"
            android:contentDescription="Next Track"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_skip_next" />
    </LinearLayout>

</LinearLayout>
